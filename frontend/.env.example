# Frontend Environment Configuration (Placeholder Template)
#
# When deployed to a static hosting provider (Vercel, Netlify, Cloudflare Pages, S3):
# Set VITE_API_BASE_URL to your backend API service URL (e.g. https://chefmind-backend.onrender.com).
#
# In local development:
# Leave this unset or empty so Vite's dev server proxies "/api" to http://localhost:3000.
#
# SECURITY NOTE:
# All variables prefixed with VITE_ are embedded into public client bundles.
# NEVER place secrets (e.g. GEMINI_API_KEY, JWT_SECRET, MONGODB_URI) in this file.

VITE_API_BASE_URL=https://your-backend-api-url.example.com
