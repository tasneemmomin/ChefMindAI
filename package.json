{
  "name": "chefmind-ai",
  "version": "1.0.0",
  "description": "AI-powered personalized culinary assistant that creates custom recipes from available ingredients using Groq and Google Gemini through a resilient LLM gateway, React, Express, and MongoDB.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "test": "node --test --import ./backend/tests/setup.js backend/tests/*.test.js",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "lint:frontend": "npm --prefix frontend run lint"
  },
  "keywords": [
    "ai",
    "recipes",
    "chef",
    "cooking",
    "gemini",
    "react",
    "express",
    "mongodb",
    "jwt",
    "vite"
  ],
  "author": "Harsh Raj",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0"
  }
}